SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server runtime only. Never expose this value through NEXT_PUBLIC_, browser
# code, logs, screenshots, chat, or commits.
SUPABASE_SECRET_KEY=sb_secret_your_server_only_key
# Legacy server-only compatibility; prefer SUPABASE_SECRET_KEY.
# SUPABASE_SERVICE_ROLE_KEY=your_legacy_service_role_key

# Compatibility only for an existing project that has not migrated keys yet.
# SUPABASE_KEY=your_legacy_anon_key

NEXTAUTH_SECRET=replace-with-a-long-random-value
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret
AUTH_TRUST_HOST=true
# AUTH_DEBUG=false

# AI concierge: direct Gemini is the default. Keep every credential server-only;
# never add NEXT_PUBLIC_, expose it to browser code, log it, or commit it.
AI_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-studio-api-key
# Optional. Direct Google model IDs have no provider prefix.
# AI_CONCIERGE_MODEL=gemini-3.6-flash
# Optional independent model override for booking risk Briefings.
# AI_BOOKING_INSIGHT_MODEL=gemini-3.6-flash
# Exact cross-origin admin origins, comma-separated when multiple deployments
# are required. Development also permits localhost/127.0.0.1 on port 5173.
# AI_ADMIN_ORIGIN=https://admin.example.com
# Optional for restricted local networks. Server runtime only; native Node fetch
# does not automatically use these variables. AI_HTTPS_PROXY takes precedence.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# AI_HTTPS_PROXY=http://127.0.0.1:7890

# Optional alternative: route a provider/model slug through Vercel AI Gateway.
# AI_PROVIDER=gateway
# AI_GATEWAY_API_KEY=your-ai-gateway-api-key
# AI_CONCIERGE_MODEL=openai/gpt-5.6-terra
# VERCEL_OIDC_TOKEN is also accepted for Gateway deployments/local Vercel auth.
